<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(ModRepositoryRoot)shared/ModEngineering/build/PcBuild.props" />
    <Import Project="$(ModRepositoryRoot)shared/ModEngineering/build/SharedDependencies.props" />

    <PropertyGroup>
        <ModPlatform>pc</ModPlatform>
        <Authors>Jitsu</Authors>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Version>1.2.0</Version>
        <LangVersion>latest</LangVersion>
        <DebugType>none</DebugType>
        <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <GameDlls Include="$(GameInteropDir)/*.dll" />
        <Reference Include="@(GameDlls)">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference
            Include="BepInEx.Unity.IL2CPP"
            Version="$(BepInExVersion)"
            IncludeAssets="compile"
        />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="$(BepInExPluginInfoVersion)" />
    </ItemGroup>
</Project>
